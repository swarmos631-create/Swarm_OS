# SwarmOS configuration — copy to .env and adjust. Placeholders only; never commit real secrets.
# Every variable is optional in development; production validation is stricter (see docs/SECURITY.md).

# --- Core -------------------------------------------------------------------
SWARMOS_ENV=development                 # development | test | production
SWARMOS_LOG_LEVEL=INFO
# SQLite (default, dev) or PostgreSQL (production): postgresql+psycopg://user:pass@host:5432/swarmos
# SWARMOS_DATABASE_URL=sqlite:////absolute/path/to/var/swarmos.db
# If SWARMOS_DATABASE_URL is unset, DATABASE_URL or POSTGRES_URL is used (as injected by Vercel/Neon); postgres:// is
# rewritten to postgresql+psycopg://. On Vercel (VERCEL=1) SQLite is refused.
# DATABASE_URL=

# --- Security ---------------------------------------------------------------
SWARMOS_SESSION_TTL_HOURS=12
# SWARMOS_COOKIE_SECURE=true            # defaults to true in production (HTTPS required)
# SWARMOS_CORS_ORIGINS=                 # comma-separated; leave empty when the API serves the PWA (same origin)
# SWARMOS_TRUSTED_HOSTS=swarmos.example.gov.in
SWARMOS_LOGIN_RATE_LIMIT_PER_MINUTE=10
SWARMOS_TASK_RATE_LIMIT_PER_MINUTE=30
# Development only: fixed password for the seeded dev accounts. If unset, a random one is written to var/dev-credentials.txt.
# SWARMOS_DEV_SEED_PASSWORD=

# --- Data -------------------------------------------------------------------
SWARMOS_DEMO_MODE=true                  # seeds SYNTHETIC fixtures for pilot cities; set false once real feeds exist
SWARMOS_DEMO_PILOT_CITIES=bengaluru,mumbai,delhi
SWARMOS_SYNC_ENABLED=true
SWARMOS_SYNC_INTERVAL_MINUTES=30
SWARMOS_SYNC_CITIES=bengaluru,mumbai,delhi
# data.gov.in API key for the CPCB station feed (free registration at https://data.gov.in)
# SWARMOS_OGD_API_KEY=
# OpenAQ v3 key (free, https://explore.openaq.org) — CPCB/state monitoring stations, reachable from any country
# SWARMOS_OPENAQ_API_KEY=
# TomTom developer key — live road speeds
# SWARMOS_TOMTOM_API_KEY=
# Optional Overpass mirrors (comma-separated). Use a self-hosted instance for heavy use.
# SWARMOS_OVERPASS_URLS=https://overpass-api.de/api/interpreter

# --- Worker / orchestration ---------------------------------------------------
# SWARMOS_JOB_MODE=worker               # worker (default) | inline (default on Vercel: jobs run after the response)
SWARMOS_WORKER_EMBEDDED=true            # false → run `swarmos worker` as a separate process (ignored in inline mode)
# Bearer token for GET /api/internal/cron (Vercel sends CRON_SECRET automatically). Unset → the endpoint is disabled.
# CRON_SECRET=
# SWARMOS_CRON_BUDGET_SECONDS=240       # time the cron spends draining the queue; keep below the function maxDuration
SWARMOS_AGENT_MAX_CONCURRENCY=6
SWARMOS_AGENT_DEFAULT_TIMEOUT_SECONDS=20
SWARMOS_TASK_MAX_AGENTS=14

# --- Local AI runtime (no hosted LLM APIs exist in SwarmOS) ---------------------
# SWARMOS_OLLAMA_URL=http://127.0.0.1:11434
# SWARMOS_OLLAMA_MODEL=llama3.2:3b
# SWARMOS_LLAMACPP_URL=http://127.0.0.1:8080
SWARMOS_LLM_NARRATIVES_ENABLED=false    # true → summarizer agents may use the local LLM for prose (facts stay structured)
SWARMOS_ALLOW_REMOTE_MODEL_HOSTS=false  # only for a self-hosted inference server you operate
SWARMOS_MODEL_MAX_CONCURRENCY=2

# --- Frontend (build-time, Vite) ----------------------------------------------
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
