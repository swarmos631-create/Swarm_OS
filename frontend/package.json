{
  "name": "swarmos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SwarmOS operations center — installable PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
